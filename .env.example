# Environment variables for PhantaSpace smart contracts
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains private keys and API secrets.

# ── RPC node URLs ──────────────────────────────────────────────────────────────
# Use Alchemy, Infura, Moralis, or any compatible node provider.
Rinkeby_URL=https://eth-rinkeby.alchemyapi.io/v2/YOUR_ALCHEMY_KEY
Mainnet_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_ALCHEMY_KEY
Polygon_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
Polygon_Mumbai_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer credentials ───────────────────────────────────────────────────────
# Use a dedicated deployer wallet. Never use your main wallet's key here.
# Either mnemonic OR private key — not both.
Rinkeby_account_mnemonic=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
Mainnet_private_key=0xYOUR_MAINNET_DEPLOYER_PRIVATE_KEY
Polygon_private_key=0xYOUR_POLYGON_DEPLOYER_PRIVATE_KEY
Polygon_Mumbai_private_key=0xYOUR_POLYGON_MUMBAI_DEPLOYER_PRIVATE_KEY

# ── Block explorer API keys ────────────────────────────────────────────────────
# For contract verification: https://etherscan.io/myapikey
Etherscan_api=YOUR_ETHERSCAN_API_KEY
# For Polygon verification: https://polygonscan.com/myapikey
Polygon_api=YOUR_POLYGONSCAN_API_KEY

# ── Gas reporter ───────────────────────────────────────────────────────────────
Gas_price_api=https://api.etherscan.io/api?module=proxy&action=eth_gasPrice
Matic_price_api=https://api.polygonscan.com/api?module=proxy&action=eth_gasPrice
# CoinMarketCap API key for USD gas cost estimates: https://coinmarketcap.com/api/
Coin_market_cap_api=YOUR_COINMARKETCAP_API_KEY
